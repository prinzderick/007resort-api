# 007 Resort & Spa API — environment reference. PLACEHOLDER VALUES ONLY.
# Copy to `.env` (git-ignored). Real secrets live in the secret store / server env, never in git.

APP_NAME="007 Resort API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8007
APP_TIMEZONE=UTC

# --- Two-node model (ADR-0013). Same codebase runs as either node. ---
# local = on-premises Local node (authoritative for on-site operations); cloud = Cloud node.
APP_NODE=local
# Site this node serves (UUID of the `site` row). Empty until the site is created/seeded.
SITE_ID=
# Optional: organization UUID (resolved from the site when empty).
ORGANIZATION_ID=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL 8.4 ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=r007
DB_USERNAME=r007_app
DB_PASSWORD=<set-in-secret-store>

# --- Redis (queue / cache / session / rate limiting). Never authoritative storage. ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=r007_

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

# --- Hashing: Argon2id (architecture/17). Tune memory/time per host. ---
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# --- Identity ---
IDENTITY_ACCESS_TTL_MINUTES=15
IDENTITY_REFRESH_TTL_DAYS=30
IDENTITY_MAX_FAILED_LOGINS=5
IDENTITY_LOCKOUT_MINUTES=15

# --- Realtime (Laravel Reverb, Pusher protocol; contract: api/realtime.md). Key is public; secret never leaves the server. ---
REVERB_APP_ID=r007-local
REVERB_APP_KEY=r007-local-key
REVERB_APP_SECRET=<generate-a-random-secret>
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# --- Node / clients ---
API_PORT=8007
NODE_ID=
