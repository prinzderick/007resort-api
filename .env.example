# 007 Resort & Spa API — environment reference. PLACEHOLDER VALUES ONLY.
# Copy to `.env` (git-ignored). Real secrets live in the secret store / server env, never in git.

APP_NAME="007 Resort API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8007
APP_TIMEZONE=UTC

# --- Two-node model (ADR-0013). Same codebase runs as either node. ---
# local = on-premises Local node (authoritative for on-site operations); cloud = Cloud node.
APP_NODE=local
# Site this node serves (UUID of the `site` row). Empty until the site is created/seeded.
SITE_ID=
# Optional: organization UUID (resolved from the site when empty).
ORGANIZATION_ID=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- MySQL 8.4 ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=r007
DB_USERNAME=r007_app
DB_PASSWORD=<set-in-secret-store>

# --- Redis (queue / cache / session / rate limiting). Never authoritative storage. ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=r007_

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
BROADCAST_CONNECTION=reverb

# --- Hashing: Argon2id (architecture/17). Tune memory/time per host. ---
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

# --- Identity ---
IDENTITY_ACCESS_TTL_MINUTES=15
IDENTITY_REFRESH_TTL_DAYS=30
IDENTITY_MAX_FAILED_LOGINS=5
IDENTITY_LOCKOUT_MINUTES=15

# --- Realtime (Laravel Reverb, Pusher protocol; contract: api/realtime.md). Key is public; secret never leaves the server. ---
REVERB_APP_ID=r007-local
REVERB_APP_KEY=r007-local-key
REVERB_APP_SECRET=<generate-a-random-secret>
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# --- Node / clients ---
API_PORT=8007
NODE_ID=

# --- CORS (web clients: KDS, admin). Comma separated origins; * is fine on the LAN Local node, restrict on the Cloud node ---
CORS_ALLOWED_ORIGINS=*

# --- Payments (ADR-0009 Paystack, ADR-0011 receipts). PLACEHOLDERS ONLY: real keys live in the secret store. ---
PAYSTACK_SECRET_KEY=<set-in-secret-store>
PAYSTACK_PUBLIC_KEY=<set-in-secret-store>
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=https://<your-public-host>/payment/return
PAYSTACK_TIMEOUT_SECONDS=15
# Optional source-IP allow-list for POST /api/v1/payments/webhooks/paystack (comma separated). Empty = signature check only.
PAYSTACK_WEBHOOK_ALLOWED_IPS=
RECEIPT_BUSINESS_NAME=
RECEIPT_SITE_ADDRESS=
RECEIPT_FOOTER="Thank you for choosing 007 Resort & Spa"
RECEIPT_TIMEZONE=Africa/Lagos
RECEIPT_COLUMNS=48
PAYMENT_REVERSAL_WINDOW_HOURS=24

# --- Sync engine (ADR-0013, docs/sync-engine.md). Same codebase, two roles. ---
# NODE_ROLE is an alias of APP_NODE (APP_NODE wins if both are set).
NODE_ROLE=local
# The peer this node talks to. Local -> Cloud base URL; Cloud never calls Local (Local polls Cloud).
PEER_URL=https://cloud.example.invalid
# Credential THIS node presents to its peer (Local: goes in the Local secret store). Generate: php artisan r007:sync:token local
PEER_NODE_TOKEN=<generated-by-r007:sync:token>
# Credentials the peer may present to us: comma-separated "<peerNode>[@<siteUuid>]:<sha256-hex>". Put on the CLOUD node.
# Two entries for the same peer = rotation window. Only hashes, never tokens.
NODE_TOKEN_HASHES=local:<sha256-hex-from-r007:sync:token>
# Heartbeat: Local sends every SYNC_HEARTBEAT_INTERVAL s; Cloud marks the site OFFLINE after SYNC_STALE_AFTER s of silence
# (default 3 missed heartbeats) and closes the immediate-online-order gate (SiteAvailability::isLocalFresh()).
SYNC_HEARTBEAT_INTERVAL=30
SYNC_STALE_AFTER=90
# Outbox publisher / puller cadence and retry policy (exponential backoff with jitter).
SYNC_PUBLISH_INTERVAL=5
SYNC_PULL_INTERVAL=5
SYNC_BATCH_SIZE=50
SYNC_BACKOFF_BASE=5
SYNC_BACKOFF_CAP=300
SYNC_MAX_ATTEMPTS=8
# Per-credential rate limit on /sync/* (per minute, Redis).
SYNC_RATE_LIMIT_PER_MINUTE=600
# Out-of-order events wait this long for their predecessor, then escalate to ENTITY_VERSION_CONFLICT.
SYNC_DEFER_ESCALATE_AFTER=900

# --- Membership / Attendance / Reporting (docs/members-attendance-reporting.md) ---
# Reception sale with tenders == plan price activates immediately (until Payments is wired). false = wait for PaymentCaptured.
MEMBERSHIP_TRUST_RECEPTION_TENDERS=true
# Seconds within which repeated punches by one person on one terminal count as a single tap.
ATTENDANCE_DEBOUNCE_SECONDS=120
# ZKTeco /iclock endpoints cannot send auth headers: restrict to the terminal LAN, e.g. 192.168.10.0/24 (comma-separated). Empty = any.
ATTENDANCE_ICLOCK_ALLOWED_CIDRS=
# Cloud node: flag report figures stale when the site's last sync is older than this many seconds.
REPORTING_STALE_AFTER_SECONDS=300

# --- Customer / public API (docs/CUSTOMER_PUBLIC_API.md) ---
CUSTOMER_WEB_URL=http://127.0.0.1:8092
CUSTOMER_ACCESS_TTL_MINUTES=480
CUSTOMER_ALLOWED_CALLBACK_HOSTS=
SERVICE_TOKEN_GRACE_HOURS=24

# --- Social sign-in (docs/CUSTOMER_SOCIAL_LOGIN.md). The website runs the OAuth flow; provider secrets live on the WEBSITE, not here. ---
SOCIAL_PROVIDERS_ENABLED=google,facebook
# providers whose emailVerified claim is honoured (facebook stays untrusted unless the owner decides otherwise)
SOCIAL_TRUSTED_EMAIL_PROVIDERS=google
# providers for which only a server-verified idToken is accepted (claims mode refused), e.g. google
SOCIAL_REQUIRE_ID_TOKEN=
# Google OAuth client id(s), comma separated: enables server-side idToken verification
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# POST /customer/auth/social/token (idToken only, no service token; for a future mobile app)
SOCIAL_ID_TOKEN_PUBLIC_ENABLED=false
SOCIAL_LINK_CONFIRM_TTL_MINUTES=30
PUBLIC_SITE_NAME=
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_ADDRESS=
PUBLIC_OPENING_HOURS=
MAIL_MAILER=log

# --- Waiter collection (docs/WAITER_COLLECTION.md); all optional ---
PAY_LINK_BASE_URL=
PAYMENTS_COLLECTION_EXPIRY_MINUTES=30
PAYMENTS_HANDOVER_MAX_VARIANCE=500
PAYMENTS_TRANSFER_ACCOUNT_TTL_MINUTES=60
PAYMENTS_COLLECTION_DEFAULT_EMAIL=pay@collect.007resort.invalid
PAYMENTS_TERMINAL_PAYSTACK_ENABLED=false

# --- Website CMS (docs/CMS_API.md); all optional ---
CMS_WEB_URL=http://127.0.0.1:8092
CMS_MEDIA_DISK=public
CMS_MEDIA_URL=
CMS_SYNC_EMIT=false
CMS_TIMEZONE=Africa/Lagos
