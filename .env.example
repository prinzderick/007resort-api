# Otueke API — environment variable reference.
# Copy to `.env` (git-ignored) or, preferably, use `dotnet user-secrets` for local development.
# PLACEHOLDER VALUES ONLY. Real secrets are provided via the secret store (user-secrets locally,
# the site vault / cloud secret manager in deployed environments) and are NEVER committed.

# ASP.NET Core hosting
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Deployment role of this instance: Site (on-premises facility server) or Cloud.
Otueke__DeploymentMode=Site

# MySQL 8.4 connection string (the API is the only component that talks to MySQL).
# Example shape only — use a least-privilege app user, TLS where available.
ConnectionStrings__Otueke=Server=localhost;Port=3306;Database=otueke;User ID=otueke_app;Password=<set-in-secret-store>;SslMode=Preferred

# JWT / token signing key — provided via secret store, never committed. Reference only.
# Otueke__Auth__SigningKey=<provided-via-secret-store>
# Otueke__Auth__Issuer=https://otueke.local
# Otueke__Auth__Audience=otueke-clients

# Site -> Cloud sync (Site mode only). Endpoint placeholder; credentials via secret store.
# Otueke__Sync__CloudEndpoint=https://cloud.example.invalid
# Otueke__Sync__SiteId=<site-uuid>
# Otueke__Sync__ClientSecret=<provided-via-secret-store>

# Logging overrides (optional)
# Serilog__MinimumLevel__Default=Information
